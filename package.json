{
  "name": "tinkercad-qhl",
  "version": "1.3.5",
  "main": "out/index.js",
  "date": "2026-03-21",
  "scripts": {
    "compile": "tsc && tsc -p tsconfig.preload.json",
    "compile:watch": "tsc --watch",
    "test": "npm run compile && node --test out/test/utils.test.js out/test/pythonUtils.test.js",
    "start": "npm run compile && electron .",
    "start:debug": "npm run compile && cross-env TINKERCAD_DEBUG=1 electron .",
    "build": "npm run compile && electron-builder",
    "build:win": "npm run compile && electron-builder --win zip",
    "build:win:debug": "node scripts/set-debug-mode.js true && npm run compile && electron-builder --win zip && node scripts/set-debug-mode.js false",
    "build:linux": "npm run compile && electron-builder --linux",
    "build:mac": "npm run compile && electron-builder --mac",
    "build:all": "npm run compile && electron-builder --win zip --linux zip",
    "monitor-microbit": "node scripts/monitor_microbit_drive.js",
    "docs": "typedoc --options typedoc.mjs"
  },
  "keywords": [],
  "author": "Sébastien Canet",
  "license": "GPL-3.0",
  "type": "module",
  "description": "Application desktop Tinkercad QHL — compilation et téléversement Arduino et micro:bit",
  "repository": "github:LibrEduc/Tinkercad-QHL",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "cross-env": "^10.1.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "sharp": "^0.34.5",
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.tinkercad.desktop",
    "copyright": "Copyright © 2026 Sébastien Canet - LibrEduc",
    "productName": "Tinkercad QHL",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "defaultArch": "x64",
      "icon": "assets/autodesk-tinkercad.png",
      "executableName": "Tinkercad QHL",
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "zip"
      ],
      "category": "Education",
      "icon": "assets/autodesk-tinkercad.png",
      "artifactName": "${productName}-${version}-Linux-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "icon": "assets/autodesk-tinkercad.png",
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "arduino",
        "to": "../arduino",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "microbit",
        "to": "../microbit",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets",
        "to": "../assets",
        "filter": [
          "*.svg",
          "*.png"
        ]
      }
    ],
    "files": [
      "**/*",
      "!src/**",
      "!tsconfig*.json",
      "!typedoc.mjs",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ]
  },
  "dependencies": {
    "@microbit/microbit-fs": "^0.10.0",
    "electron-prompt": "^1.7.0"
  }
}
